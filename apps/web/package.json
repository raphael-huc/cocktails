{
  "name": "@cocktails/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6008",
    "build-storybook": "storybook build",
    "codegen": "paraglide-js compile --project ./project.inlang --outdir ./src/shared/i18n/paraglide --strategy localStorage preferredLanguage baseLocale --silent && tsr generate",
    "typecheck": "pnpm codegen && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "arch": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@cocktails/ui": "workspace:*",
    "@directus/sdk": "^27.1.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@inlang/paraglide-js": "^3.2.2",
    "@rolldown/plugin-babel": "^0.3.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-cli": "^1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dependency-cruiser": "^18.8.0",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
