# Text files use LF line endings everywhere, including on Windows checkouts:
# it is what Biome writes, so files do not flip between LF and CRLF.
* text=auto eol=lf

# Never touch the bytes of these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated: keep it out of the way in diffs and merges.
pnpm-lock.yaml linguist-generated=true -diff
